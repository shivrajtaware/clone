# ── MediCore HMS Backend Environment Variables ──────────────────────────────
# 🔒 SECURITY: This is a TEMPLATE file. Copy to .env and update values.
# ⚠️  NEVER commit real credentials to version control.
# 📝 Use the corresponding .env.development for local development.

# Server Configuration
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://app.yourdomain.com

# Database (PostgreSQL) - Use strong password!
DATABASE_URL="postgresql://db_user:STRONG_PASSWORD_HERE@db_host:5432/medicore_db"

# JWT Secrets (Generate using: openssl rand -base64 32)
JWT_SECRET=GENERATE_64_CHAR_RANDOM_STRING_USING_OPENSSL_OR_CRYPTO_LIB
JWT_REFRESH_SECRET=GENERATE_ANOTHER_64_CHAR_RANDOM_STRING_USING_OPENSSL_OR_CRYPTO_LIB
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Super Admin Credentials - CHANGE IN PRODUCTION
SUPER_ADMIN_EMAIL=admin@yourhospital.com
SUPER_ADMIN_PASSWORD=GENERATE_STRONG_PASSWORD_MIN_12_CHARS_WITH_SYMBOLS

# Email Service (SendGrid recommended for production reliability)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM=noreply@yourhospital.com
# Fallback SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password

# Twilio (SMS + WhatsApp Integration) - Optional
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE=+1234567890
TWILIO_WHATSAPP=whatsapp:+14155238886

# File Storage (Use S3 for production)
STORAGE_TYPE=s3
AWS_ACCESS_KEY=your_aws_access_key_id
AWS_SECRET_KEY=your_aws_secret_access_key
AWS_BUCKET=medicore-hospital-uploads
AWS_REGION=ap-south-1

# Rate Limiting (per 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# WebSocket Configuration
SOCKET_CORS_ORIGIN=https://app.yourdomain.com


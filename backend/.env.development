# ── MediCore HMS Backend — Development Environment ──────────────────────────
# This is for LOCAL DEVELOPMENT ONLY. DO NOT use in production.

NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL local)
DATABASE_URL="postgresql://medicore_user:medicore_pass_dev@localhost:5432/medicore_db_dev"

# JWT (for development only)
JWT_SECRET=dev_secret_string_change_in_production_use_64_chars_min
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production_use_64_chars_min
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Super Admin (dev credentials)
SUPER_ADMIN_EMAIL=admin@medicore.local
SUPER_ADMIN_PASSWORD=MediCore@Dev123

# Email (development)
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_username
SMTP_PASS=your_mailtrap_password
EMAIL_FROM=noreply@medicore.local

# Twilio (optional for dev)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=
TWILIO_WHATSAPP=

# File Storage (local for dev)
STORAGE_TYPE=local
UPLOAD_DIR=./uploads

# Rate Limiting (relaxed for dev)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Socket.io
SOCKET_CORS_ORIGIN=http://localhost:5173

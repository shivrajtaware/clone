# ── MediCore HMS Frontend Environment Variables ─────────────────────────────
# Keep browser traffic on the same host as the deployed UI. Vite proxies these
# paths during development and nginx/server routing handles them in production.
VITE_API_URL=/api
VITE_SOCKET_URL=
VITE_APP_NAME=MediCore HMS
VITE_COMPANY_NAME=MediCore Technologies

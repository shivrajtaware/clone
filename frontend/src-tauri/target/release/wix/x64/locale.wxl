<WixLocalization Culture="en-us" xmlns="http://schemas.microsoft.com/wix/2006/localization"><String Id="TauriLanguage">1033</String><String Id="TauriCodepage">1252</String><String Id="LaunchApp">Launch MediCore HMS</String><String Id="DowngradeErrorMessage">A newer version of MediCore HMS is already installed.</String><String Id="PathEnvVarFeature">Add the install location of the MediCore HMS executable to the PATH system environment variable. This allows the MediCore HMS executable to be called from any location.</String><String Id="InstallAppFeature">Installs MediCore HMS.</String></WixLocalization>